{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://477.local/result.schema.json",
  "title": "Measured run plus optional human rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "pipeline",
    "run_id",
    "item_id",
    "model_id",
    "runtime_config",
    "input_fingerprint",
    "prediction",
    "human_grading",
    "latency_ms",
    "estimated_cost_usd",
    "input_tokens",
    "output_tokens"
  ],
  "properties": {
    "benchmark_version": {
      "const": "477-reasoning-v1"
    },
    "pipeline": {
      "enum": [
        "vlm_only",
        "cv_llm"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "enum": [
        "ITEM_01",
        "ITEM_02",
        "ITEM_03",
        "ITEM_04",
        "ITEM_05",
        "ITEM_06",
        "ITEM_07"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_config": {
      "type": "object"
    },
    "input_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_sha256",
        "prediction_schema_sha256",
        "media_sha256",
        "sampling_protocol_id",
        "frame_numbers"
      ],
      "properties": {
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prediction_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_sha256": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "enum": [
              "CAM_01",
              "CAM_02",
              "CAM_03"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sampling_protocol_id": {
          "const": "uniform_total64_v1"
        },
        "frame_numbers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "enum": [
              "CAM_01",
              "CAM_02",
              "CAM_03"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "prediction": {
      "$ref": "https://477.local/prediction.schema.json"
    },
    "human_grading": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "reviewer",
        "event_understanding",
        "temporal_understanding",
        "evidence_grounding",
        "uncertainty_calibration",
        "overclaim_flags",
        "notes"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "event_understanding": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "temporal_understanding": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "evidence_grounding": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "uncertainty_calibration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "overclaim_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "evidence_quote",
              "reason"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "unsupported medical diagnosis",
                  "unsupported criminal intent",
                  "unsupported authorization claim",
                  "unsupported identity claim",
                  "unsupported weapon claim",
                  "unsupported cross-camera identity claim"
                ]
              },
              "evidence_quote": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "estimated_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
