# python -m uvicorn app.main:app --env-file .env --reload --host 127.0.0.1
APP_MODE=demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_ROOT=media
# Explicit real slot: currently fails to human review until implemented.
# For a mock integration smoke test, choose mock_local_cv explicitly.
MODEL_ADAPTER=local_cv
MODEL_TIMEOUT_SEC=5
