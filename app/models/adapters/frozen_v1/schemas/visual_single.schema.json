{
  "$comment": "P4 single-camera assessment template (strict Structured Outputs). __FRAME_REFS__ is replaced per request by the frame refs actually supplied. Category taxonomy and decision fields identical to P3; numbers are model-generated estimates in [0,1].",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident", "incident_category", "severity", "imminence", "exposure", "persistence", "human_review", "evidence", "temporal_summary", "uncertainties", "reason"],
  "properties": {
    "incident": {"type": "object", "additionalProperties": false, "required": ["probability"], "properties": {"probability": {"type": "number", "minimum": 0, "maximum": 1}}},
    "incident_category": {"type": "object", "additionalProperties": false, "required": ["value", "confidence"],
                          "properties": {"value": {"type": "string", "enum": ["no_clear_incident", "possible_fall_or_person_down", "possible_physical_conflict",
                                                                               "possible_scene_or_boundary_entry", "other_safety_relevant", "uncertain"]},
                                         "confidence": {"type": "number", "minimum": 0, "maximum": 1}}},
    "severity": {"type": "object", "additionalProperties": false, "required": ["score"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
    "imminence": {"type": "object", "additionalProperties": false, "required": ["score"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
    "exposure": {"type": "object", "additionalProperties": false, "required": ["score"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
    "persistence": {"type": "object", "additionalProperties": false, "required": ["score"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
    "human_review": {"type": "object", "additionalProperties": false, "required": ["probability"], "properties": {"probability": {"type": "number", "minimum": 0, "maximum": 1}}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 6,
                 "items": {"type": "object", "additionalProperties": false, "required": ["frame_ref", "description"],
                           "properties": {"frame_ref": {"type": "string", "enum": ["__FRAME_REFS__"]}, "description": {"type": "string"}}}},
    "temporal_summary": {"type": "string"},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"}
  }
}
